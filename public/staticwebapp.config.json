{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/404.html",
      "/*.css",
      "/*.js",
      "/*.svg",
      "/*.jpg",
      "/*.png",
      "/*.pdf",
      "/*.ico",
      "/*.json",
      "/*.txt",
      "/*.xml",
      "/*.webmanifest",
      "/*.woff",
      "/*.woff2",
      "/*.map"
    ]
  }
}
